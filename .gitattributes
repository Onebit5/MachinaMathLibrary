# Language detection (GitHub Linguist)
*.h     linguist-language=C++
*.inc   linguist-language=C++

# Line ending normalisation
# Default: normalise all text files to LF
* text=auto eol=lf

# Windows / Visual Studio specific files
*.bat      eol=crlf
*.cmd      eol=crlf
*.sln      eol=crlf
*.csproj  eol=crlf
*.vcxproj eol=crlf
*.props   eol=crlf
misc/msvs/** eol=crlf

# Files where EOLs are semantically relevant
*.test.txt -text

# Binary files (explicit, for older Git versions and safety)
*.icns binary
*.ico  binary
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ttf  binary
*.otf  binary
*.tza  binary
